DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
JWT_EXPIRATION_MS=3600000

# Bind the Docker backend to localhost:8081 while the Windows backend uses :8080.
# Change to 8080 only after manually stopping the Windows backend.
BACKEND_HOST_PORT=8081
# Private lab origins only; public HTTP/HTTPS targets do not need allowlist entries.
SCANNER_ALLOWED_PRIVATE_TARGET_ORIGINS=http://juice-shop:3000,http://dvwa:80

# Optional ZAP overlay: set a unique key before using docker-compose.zap.yml.
SCANNER_ZAP_API_KEY=
ZAP_HOST_PORT=8090

# Optional SUPER_ADMIN bootstrap account (see RoleInitializer).
# Set both values through a local untracked .env file or a deployment secret manager.
# Leave both blank to skip bootstrap. Never commit real credentials.
INITIAL_SUPER_ADMIN_EMAIL=
INITIAL_SUPER_ADMIN_PASSWORD=
